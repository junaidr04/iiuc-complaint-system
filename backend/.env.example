# Port the Express API runs on
PORT=5000

# MongoDB Atlas connection string (Cluster0, db: iiuc_complaint_system)
MONGODB_URI="MY_MONGODB_ATLAS_URI"

# Gemini API key for the AI Smart Assistant feature (optional — falls back to rule engine if empty)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Frontend URL, used for CORS
CLIENT_URL="http://localhost:5173"
